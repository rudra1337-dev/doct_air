# ======================================================
# LOOP - MERN Stack Monorepo .gitignore
# ======================================================

# -----------------------
# Dependencies
# -----------------------
node_modules/
**/node_modules/

# -----------------------
# Logs
# -----------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------
# Runtime Data
# -----------------------
pids
*.pid
*.seed
*.pid.lock

# -----------------------
# Environment Variables
# -----------------------
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
.env.*

!.env.example

# -----------------------
# Build Output
# -----------------------
dist/
build/
out/
coverage/
storybook-static/

# -----------------------
# Vite
# -----------------------
vite.svg

# -----------------------
# Cache
# -----------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.nyc_output/
*.tsbuildinfo

# -----------------------
# Temporary Files
# -----------------------
tmp/
temp/
*.tmp

# -----------------------
# Operating System Files
# -----------------------
.DS_Store
Thumbs.db
Desktop.ini

# -----------------------
# IDE / Editors
# -----------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

.idea/
*.iml

# -----------------------
# Local Database
# -----------------------
*.sqlite
*.sqlite3

# -----------------------
# MongoDB Local Files
# -----------------------
data/db/

# -----------------------
# Uploads (Optional)
# -----------------------
backend/uploads/*
!backend/uploads/.gitkeep

# -----------------------
# Generated Reports
# -----------------------
reports/
exports/

# -----------------------
# Testing
# -----------------------
coverage/
test-results/
playwright-report/

# -----------------------
# Docker
# -----------------------
docker-data/
*.tar

# -----------------------
# Secrets
# -----------------------
*.pem
*.key
*.crt
*.p12

# -----------------------
# Misc
# -----------------------
*.swp
*.swo
*.bak
*.orig

# -----------------------
# AI / Gemini
# -----------------------
gemini-api-key.txt
api-keys.txt
secrets.json

# -----------------------
# Package Managers
# -----------------------
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# -----------------------
# Firebase (if added later)
# -----------------------
.firebase/

# -----------------------
# Vercel
# -----------------------
.vercel/

# -----------------------
# Render
# -----------------------
.render/

# -----------------------
# Netlify
# -----------------------
.netlify/

# -----------------------
# Turborepo (Future)
# -----------------------
.turbo/

# -----------------------
# Optional Docs
# -----------------------
*.pdf
*.pptx

# Keep documentation folder
!docs/